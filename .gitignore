# --- Project Specific ---
# Ignore the hidden Next.js build folder (mandatory)
.next/
# Ignore any root build or dist folders
dist/
build/
out/

# --- Dependencies ---
# Never commit node_modules
node_modules/

# --- Environment & Secrets ---
# Keep your secrets private
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT ignore the example file so others know what keys to use
!.env.example

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & IDE ---
.DS_Store
Thumbs.db
# We keep .vscode/settings.json usually, but ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# --- Docker ---
# Ignore local overrides
docker-compose.override.yml

# --- Testing ---
coverage/
.nyc_output/