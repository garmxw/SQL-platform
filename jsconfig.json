{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "#server/*": ["./src/server/*"],
      "#app/*": ["./src/app/*"],
      "#shared/*": ["./src/shared/*"],
      "#db/*": ["./src/server/database/*"],
      "@/*": ["./src/*"],
      "#src/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules"]
}
