{
  "name": "sql-platform",
  "version": "1.0.0",
  "description": "SQL Teaching Platform - Unified Next.js & Express",
  "main": "server/src/index.js",
  "type": "module",
  "imports": {
    "#server/*": "./src/server/*",
    "#app/*": "./src/app/*",
    "#shared/*": "./src/shared/*",
    "#db/*": "./src/server/database/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev:backend": "nodemon --exec ts-node --esm src/server/index.ts",
    "dev:backend:js": "nodemon src/server/index.js",
    "dev:frontend": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node --loader ts-node/esm src/server/index.ts",
    "start:js": "NODE_ENV=production node src/server/index.js",
    "CreateTables": "psql -U garmx -d sql_platform_db -f ./src/server/database/schema.sql"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.4",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cookieparser": "^0.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "mailtrap": "^4.4.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "pg": "^8.18.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.7.2",
    "recharts": "^2.15.4",
    "shadcn": "^4.0.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.4.0",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
